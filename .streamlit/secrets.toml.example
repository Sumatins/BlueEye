# BlueEye deployment secrets template.
#
# Copy this file to `.streamlit/secrets.toml` for local experiments, or paste
# the entries you need into the "Secrets" field of your Streamlit Community
# Cloud app (Deploy → Advanced settings → Secrets). The real secrets file is
# git-ignored; NEVER commit filled-in values.
#
# Every value below is OPTIONAL: BlueEye runs with safe defaults when they are
# absent. Deployment-time values are merged into the environment as BLUEEYE_*
# variables before settings are built (see app/config.py), so only keys that
# start with BLUEEYE_ are read; anything else in this file is ignored.
#
# Recommended for the free 1 GB Community Cloud tier: set
# BLUEEYE_DEFAULT_MODEL to a single model (e.g. "fish_inv") so at most one
# set of weights is loaded; the combined "auto"/"all" modes load several
# models and can exceed the memory limit.

# Compute device: "auto" (default, picks CUDA when present), "cpu", "cuda".
# The cloud runners have no GPU, so "auto" already resolves to CPU.
# BLUEEYE_DEVICE = "cpu"

# Default model selection for the Detect page: "auto" (all installed models),
# "all", or a single registry id such as "fish_inv" / "megafauna".
# BLUEEYE_DEFAULT_MODEL = "fish_inv"

# Default confidence threshold (0.0-1.0) for the UI slider.
# BLUEEYE_DEFAULT_CONFIDENCE = 0.5

# Comma-separated reviewer emails allowed to formally verify identifications.
# BLUEEYE_REVIEWER_EMAILS = "reviewer@example.org"

# Background evaluation scheduler: "on" (default) or "off".
# BLUEEYE_SCHEDULER = "on"

# Upload safety limits in megabytes. Lower them on small hosts.
# BLUEEYE_MAX_IMAGE_MB = 25
# BLUEEYE_MAX_VIDEO_MB = 400

# Logging level: DEBUG, INFO (default), WARNING, ERROR.
# BLUEEYE_LOG_LEVEL = "INFO"
