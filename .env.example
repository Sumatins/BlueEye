# BlueEye configuration template.
# Copy this file to `.env` and adjust the values if needed.

# Directories (relative paths are resolved against the project root)
BLUEEYE_MODELS_DIR=models
BLUEEYE_DATA_DIR=data
BLUEEYE_OUTPUTS_DIR=outputs

# Detection defaults
#   auto       -> run every model whose weights are available (combined)
#   fish_inv   -> Fish & Invertebrates model only
#   megafauna  -> MegaFauna (shark / ray / turtle) only
BLUEEYE_DEFAULT_MODEL=auto
# 0.0 - 1.0. The published per-model optimal thresholds are
# 0.523 (FishInv) and 0.546 (MegaFauna); 0.5 is a good general default.
BLUEEYE_DEFAULT_CONFIDENCE=0.5

# Device: auto (CUDA if available, else CPU), cpu, cuda, cuda:0
BLUEEYE_DEVICE=auto

# Optional underwater enhancement (on/off) - off by default
BLUEEYE_ENHANCEMENT=off

# Upload safety limits (megabytes)
BLUEEYE_MAX_IMAGE_MB=25
BLUEEYE_MAX_VIDEO_MB=400

# Logging: DEBUG, INFO, WARNING, ERROR
BLUEEYE_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Authentication (local accounts)
# ---------------------------------------------------------------------------
# SQLite database holding accounts and sessions. Defaults to
# <outputs>/auth/blueeye_auth.db, which is git-ignored and covered by the
# outputs volume. Point this at a persistent path in production.
# BLUEEYE_AUTH_DB=outputs/auth/blueeye_auth.db

# Session lifetime in days (server-side expiry; tokens can also be revoked
# immediately on sign-out).
BLUEEYE_SESSION_TTL_DAYS=7

# Minimum password length enforced at registration and password change.
BLUEEYE_PASSWORD_MIN_LENGTH=8

